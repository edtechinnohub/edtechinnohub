---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with EdTech InnoHub.">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-6">
    <p class="text-sm font-semibold text-green mb-4">Contact</p>
    <h1 class="text-4xl md:text-5xl font-extrabold leading-tight max-w-2xl">Get in touch.</h1>
    <p class="text-lg text-slate mt-6 max-w-2xl leading-relaxed">
      Questions, partnership enquiries, or just want to say hello — reach us directly, or use the form.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 border-t border-line grid md:grid-cols-2 gap-12">
    <div>
      <div class="space-y-6">
        <div>
          <p class="text-xs font-semibold text-slate uppercase tracking-wide">Email</p>
          <a href="mailto:hello@edtechinnohub.org" class="text-ink font-medium no-underline hover:text-green">
            hello@edtechinnohub.org
          </a>
          <p class="text-xs text-slate mt-1">Update this to your real inbox address.</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate uppercase tracking-wide">Location</p>
          <p class="text-ink font-medium">Nigeria</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate uppercase tracking-wide">Partnership enquiries</p>
          <a href="/partner" class="text-green font-medium no-underline hover:underline">
            See how to partner with us →
          </a>
        </div>
      </div>
    </div>

    <div>
      <!--
        This form posts to Formspree (free tier, no backend needed).
        Set it up in 2 minutes: create a free account at formspree.io,
        create a form, and replace YOUR-FORM-ID below with the ID it gives you.
        Until then, this form won't actually send anywhere.
      -->
      <form action="https://formspree.io/f/YOUR-FORM-ID" method="POST" class="space-y-4">
        <div>
          <label for="name" class="text-sm font-medium text-ink block mb-1.5">Name</label>
          <input type="text" name="name" id="name" required class="w-full border border-line rounded-md px-3.5 py-2.5 focus:border-green focus:outline-none" />
        </div>
        <div>
          <label for="email" class="text-sm font-medium text-ink block mb-1.5">Email</label>
          <input type="email" name="email" id="email" required class="w-full border border-line rounded-md px-3.5 py-2.5 focus:border-green focus:outline-none" />
        </div>
        <div>
          <label for="organisation" class="text-sm font-medium text-ink block mb-1.5">Organisation (optional)</label>
          <input type="text" name="organisation" id="organisation" class="w-full border border-line rounded-md px-3.5 py-2.5 focus:border-green focus:outline-none" />
        </div>
        <div>
          <label for="message" class="text-sm font-medium text-ink block mb-1.5">Message</label>
          <textarea name="message" id="message" rows="5" required class="w-full border border-line rounded-md px-3.5 py-2.5 focus:border-green focus:outline-none"></textarea>
        </div>
        <button type="submit" class="inline-flex items-center bg-forest text-white px-5 py-3 rounded-md font-semibold hover:bg-green transition-colors">
          Send message
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
