---
import BaseLayout from '../layouts/BaseLayout.astro';

const partners = ['Schools', 'NGOs', 'Foundations', 'Government institutions', 'Corporates', 'Development organisations', 'Researchers', 'Educators', 'Technology organisations'];
const areas = ['Training', 'Education', 'Research', 'Technology', 'Community Programmes', 'CSR', 'Content Development'];
---

<BaseLayout title="Partner With Us" description="Collaborate with EdTech InnoHub on training, education, research, technology and community programmes.">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-6">
    <p class="text-sm font-semibold text-green mb-4">Partner with us</p>
    <h1 class="text-4xl md:text-5xl font-extrabold leading-tight max-w-2xl">
      Let's build practical solutions together.
    </h1>
    <p class="text-lg text-slate mt-6 max-w-2xl leading-relaxed">
      We welcome collaboration with organisations who share our belief that education should turn into
      real opportunity.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 border-t border-line grid md:grid-cols-2 gap-10">
    <div>
      <h2 class="text-xl font-bold mb-4">Who we partner with</h2>
      <ul class="space-y-2">
        {partners.map((p) => (
          <li class="flex items-center gap-2 text-slate">
            <span class="w-1.5 h-1.5 rounded-full bg-green shrink-0"></span>
            {p}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-xl font-bold mb-4">Areas we collaborate in</h2>
      <div class="flex flex-wrap gap-2">
        {areas.map((a) => (
          <span class="text-sm font-medium text-green bg-mint px-3 py-1.5 rounded-full">{a}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-forest text-white py-16 mt-4">
    <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <h2 class="text-2xl font-bold">Ready to talk?</h2>
        <p class="text-white/70 mt-2 max-w-md leading-relaxed">
          Tell us about your organisation and what you'd like to work on — we'll get back to you.
        </p>
      </div>
      <a href="/contact" class="inline-flex items-center bg-white text-forest px-6 py-3.5 rounded-md no-underline font-semibold hover:bg-mint transition-colors whitespace-nowrap">
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
