---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
---

<BaseLayout title="About" description="Who EdTech InnoHub is, our mission, our approach, and our founder.">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-4">
    <p class="text-sm font-semibold text-green mb-4">Who we are</p>
    <h1 class="text-4xl md:text-5xl font-extrabold leading-tight max-w-2xl">
      An education and technology social enterprise, built for real life.
    </h1>
    <p class="text-lg text-slate mt-6 max-w-2xl leading-relaxed">
      EdTech InnoHub Limited uses education, digital skills, technology, research and innovation to make
      learning more accessible, practical and relevant. We use education and technology to make learning
      practical, accessible and useful for real life.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 border-t border-line grid md:grid-cols-2 gap-10">
    <div>
      <h2 class="text-2xl font-bold mb-3">The problem</h2>
      <p class="text-slate leading-relaxed">
        Too many people can access education only in theory, while lacking the practical knowledge,
        digital skills, tools and opportunities needed to use what they learn in real life — whether
        they're a child, a young person, a teacher, or a professional.
      </p>
    </div>
    <div>
      <h2 class="text-2xl font-bold mb-3">Our model</h2>
      <p class="text-slate leading-relaxed">
        We are a <strong class="text-ink">for-profit social enterprise</strong>, not a charity. We build
        sustainable products and services that generate revenue while creating meaningful social impact —
        particularly for people who are underserved or have limited access to quality education and
        digital opportunities.
      </p>
    </div>
  </section>

  <section class="bg-mint py-16 my-4">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-3">Where we are today</h2>
      <p class="text-slate leading-relaxed max-w-2xl">
        We are building and validating our products, services
        and market. We are developing our educational resources, growing our training programmes,
        exploring partnerships and expanding our team.
        
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12">
    <h2 class="text-2xl font-bold mb-8">Our founder</h2>
    <div class="grid sm:grid-cols-[180px_1fr] gap-6 items-start">
      <PhotoSlot label="Add a real photo of Deborah Ajah" aspect="aspect-square" />
      <div>
        <h3 class="font-bold text-lg">Deborah A.</h3>
        <p class="text-sm text-green font-medium mt-0.5">Founder & CEO, EdTech InnoHub Limited</p>
        <p class="text-slate mt-4 leading-relaxed">
          Deborah's background spans education, physics, digital skills, data, research and technology.
          Her path into entrepreneurship grew from years working within education and watching the gap
          between what people are taught and what they're actually able to do with it — in practical
          learning, digital literacy, access to resources, teacher digital capacity, and youth digital
          skills. EdTech InnoHub is her answer to that gap: an organisation built by someone who has seen
          the problem up close, not just studied it.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
