---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const dateStr = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <a href="/blog" class="text-sm text-green no-underline hover:underline">← Back to blog</a>

    <p class="text-sm text-slate mt-6">{dateStr} · {post.data.author}</p>
    <h1 class="text-3xl md:text-4xl font-semibold leading-tight mt-2">{post.data.title}</h1>

    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {post.data.tags.map((tag) => (
          <span class="text-xs font-medium text-green bg-mint px-2.5 py-1 rounded-full">{tag}</span>
        ))}
      </div>
    )}

    {post.data.coverImage && (
      <img src={post.data.coverImage} alt="" class="w-full aspect-[16/9] object-cover rounded-lg mt-8" />
    )}

    <div class="prose-content max-w-prose mt-10 leading-relaxed text-ink">
      <Content />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    @apply text-2xl font-semibold mt-10 mb-4;
  }
  .prose-content h3 {
    @apply text-xl font-semibold mt-8 mb-3;
  }
  .prose-content p {
    @apply mb-5 text-[17px];
  }
  .prose-content a {
    @apply text-green hover:underline;
  }
  .prose-content ul, .prose-content ol {
    @apply mb-5 pl-6 space-y-2;
  }
  .prose-content ul {
    @apply list-disc;
  }
  .prose-content ol {
    @apply list-decimal;
  }
  .prose-content blockquote {
    @apply border-l-2 border-green pl-5 italic text-slate my-6;
  }
  .prose-content img {
    @apply rounded-lg my-6;
  }
</style>
