---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Blog" description="Stories, updates, and lessons from EdTech InnoHub's work across Nigeria.">
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-10">
    <p class="text-sm font-medium text-leaf mb-4">Stories & updates</p>
    <h1 class="text-4xl md:text-5xl font-semibold leading-tight max-w-2xl">Blog</h1>
    <p class="text-lg text-slate mt-6 max-w-2xl leading-relaxed">
      Notes from the classroom, program updates, and reflections from the EdTech InnoHub team.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-24">
    {posts.length > 0 ? (
      <div class="grid md:grid-cols-3 gap-8">
        {posts.map((post) => <BlogCard slug={post.slug} {...post.data} />)}
      </div>
    ) : (
      <div class="text-center py-16 border border-dashed border-line rounded-lg">
        <p class="text-slate">No posts yet — the first story is coming soon.</p>
      </div>
    )}
  </section>
</BaseLayout>
