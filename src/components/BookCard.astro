---
interface Props {
  title: string;
  author?: string;
  description: string;
  coverImage?: string;
  fileUrl: string;
}
const { title, author, description, coverImage, fileUrl } = Astro.props;
---

<article class="flex gap-4 border border-line rounded-lg p-5 bg-paper hover:border-leaf transition-colors">
  <div class="w-16 shrink-0 aspect-[3/4] rounded bg-mist flex items-center justify-center overflow-hidden">
    {coverImage ? (
      <img src={coverImage} alt="" class="w-full h-full object-cover" loading="lazy" />
    ) : (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5B6472" stroke-width="1.5">
        <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22.5V4.5Z"></path>
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
      </svg>
    )}
  </div>
  <div class="flex-1 min-w-0">
    <h3 class="text-lg font-semibold leading-snug">{title}</h3>
    {author && <p class="text-sm text-slate mt-0.5">by {author}</p>}
    <p class="text-sm text-slate mt-2 line-clamp-2">{description}</p>
    <a
      href={fileUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-leaf no-underline mt-3 hover:underline"
    >
      Download
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 3v13m0 0-4-4m4 4 4-4M5 21h14"></path>
      </svg>
    </a>
  </div>
</article>
