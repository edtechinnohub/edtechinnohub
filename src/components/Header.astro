---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/books', label: 'Books' },
  { href: '/resources', label: 'Resources' },
  { href: '/blog', label: 'Blog' },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-line bg-paper">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-20">
    <a href="/" class="font-display text-xl font-semibold text-ink flex items-center gap-2">
      <span class="inline-block w-3 h-3 rounded-full bg-gold"></span>
      EdTech InnoHub
    </a>

    <nav class="hidden md:flex items-center gap-8 font-body text-[15px]">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'no-underline transition-colors',
              isActive ? 'text-ink font-semibold' : 'text-slate hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <a
      href="/about#get-involved"
      class="hidden md:inline-flex items-center bg-ink text-white text-sm font-medium px-4 py-2 rounded-md no-underline hover:bg-leaf transition-colors"
    >
      Get involved
    </a>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 -mr-2" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </summary>
      <div class="absolute right-0 top-12 w-56 bg-paper border border-line rounded-lg shadow-lg py-2 z-10">
        {navItems.map((item) => (
          <a href={item.href} class="block px-4 py-2.5 text-ink no-underline hover:bg-mist">
            {item.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>
