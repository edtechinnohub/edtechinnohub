---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white mt-24">
  <div class="max-w-6xl mx-auto px-6 py-14 grid grid-cols-1 md:grid-cols-3 gap-10">
    <div>
      <p class="font-display text-lg font-semibold mb-2">EdTech InnoHub</p>
      <p class="text-white/70 text-sm max-w-xs">
        Bridging the education gap with inclusive, equitable, and quality learning opportunities — aligned with UN SDG 4.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-white/90 mb-3">Explore</p>
      <ul class="space-y-2 text-sm text-white/70">
        <li><a href="/books" class="no-underline hover:text-white">Books</a></li>
        <li><a href="/resources" class="no-underline hover:text-white">Resources</a></li>
        <li><a href="/blog" class="no-underline hover:text-white">Blog</a></li>
        <li><a href="/events" class="no-underline hover:text-white">Events</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white/90 mb-3">Get involved</p>
      <ul class="space-y-2 text-sm text-white/70">
        <li><a href="https://forms.gle/NYwMrJQuGzLjgYUXA" class="no-underline hover:text-white">Join as a Team</a></li>
        <li><a href="https://forms.gle/KQE4NgUJhaNP7ojc7" class="no-underline hover:text-white">Join as a Learner</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="max-w-6xl mx-auto px-6 py-6 text-xs text-white/50">
      © {year} EdTech InnoHub. All rights reserved.
    </p>
  </div>
</footer>
