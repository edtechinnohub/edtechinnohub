---
interface Props {
  label: string;
  src?: string;
  aspect?: string; // tailwind aspect-ratio class, e.g. 'aspect-[4/3]'
  class?: string;
}
const { label, src, aspect = 'aspect-[4/3]', class: className = '' } = Astro.props;
---

<div class={`photo-slot ${aspect} ${className}`}>
  {src ? (
    <img src={src} alt={label} loading="lazy" />
  ) : (
    <>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#5B655D" stroke-width="1.5">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <circle cx="9" cy="10" r="1.5"></circle>
        <path d="m3 16 5-5 4 4 3-3 6 6"></path>
      </svg>
      <p class="text-xs px-3 leading-snug">{label}</p>
    </>
  )}
</div>
